# === Foto na Hora — .gitignore ===

# --- Dados sensíveis (biometria / PII) — NUNCA versionar ---
**/selfies/
**/faces/
**/embeddings/
*.embedding
*.npy
guests/
sessions/

# --- Segredos / credenciais ---
.env
.env.*
*.key
*.pem
secrets/
credentials*.json
service-account*.json

# --- Dados de experimento / mídia pesada ---
experiments/**/data/
experiments/**/out/
experiments/**/results/*.raw
samples/
*.CR3
*.cr3
*.RAW
*.raw
*.mp4
# JPEGs de teste ficam fora do repo (pesados); guarde localmente
test-images/

# --- Modelos / pesos ---
models/
*.onnx
*.pt
*.pth
*.engine
*.trt

# --- Python ---
__pycache__/
*.py[cod]
.venv/
env/
.ipynb_checkpoints/

# --- Node ---
node_modules/
dist/
build/
.next/
.cache/

# --- SO / editor ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log
logs/

# modelos do test-rig (buffalo_s, ~16MB) sao versionados de proposito
!app/test_rig/models/
!app/test_rig/models/buffalo_s/
!app/test_rig/models/buffalo_s/*.onnx

# banco local do rig (dados de teste, nunca versionar)
app/test_rig/foton.db
app/test_rig/foton.db-*

# --- banco local do rig (dados reais nao entram no repo) ---
app/test_rig/foton.db-shm
app/test_rig/foton.db-wal
*.db-shm
*.db-wal

# --- estado de build do Netlify ---
.netlify/

# --- cache do Python ---
__pycache__/
*.pyc

# --- fotos reais para ensaio: NUNCA no repo (ele e publico) ---
fotos-teste/
!fotos-teste/LEIA-ME.md
